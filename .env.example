# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Used for: web-push delivery (reading the partner's push subscription)
# and cleaning storage files when an account is deleted. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public site URL (used in email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calls: a TURN relay makes Wi-Fi <-> 4G and 4G <-> 4G calls reliable (STUN alone only
# covers same-network and friendly home routers). Pick ONE. Both mint short-lived credentials on
# the server, so nothing long-lived ever reaches the browser.
#
# Option 1 - Cloudflare Realtime TURN (free tier, nothing to host).
# Cloudflare dashboard -> Realtime -> TURN -> create a key. Server only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
#
# Option 2 - your own coturn (open source), configured with `use-auth-secret` + `static-auth-secret`.
# TURN_URLS is comma separated, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=

# App lock (Settings -> Security). Signs the short "unlocked" cookie. Any long random string;
# if unset, a key derived from SUPABASE_SERVICE_ROLE_KEY is used.
APP_LOCK_SECRET=
