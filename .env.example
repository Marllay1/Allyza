# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Used for: web-push delivery (reading the partner's push subscription)
# and cleaning storage files when an account is deleted. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public site URL (used in email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calls: TURN relay so calls connect across different networks (Wi-Fi <-> 4G, 4G <-> 4G).
# Twilio Console -> Account SID + Auth Token. Server only, never exposed to the browser:
# each call gets short-lived credentials minted from these. Without them calls still work
# over STUN alone (same network / many home routers), but not reliably across mobile carriers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
